# IOC Enrichment Pipeline — Environment Variables
# Copy this to .env and fill in your API keys

# Threat Intelligence APIs (all optional — pipeline degrades gracefully)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# LLM Summarizer (optional — uses OpenRouter by default)
# OpenRouter supports many models. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternative: use OpenAI directly instead of OpenRouter
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Cache settings (optional — overrides config.yaml)
# CACHE_PATH=pipeline_cache.db
# CACHE_TTL=3600